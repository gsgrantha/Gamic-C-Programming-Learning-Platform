# Copy this file to ".env" and adjust
PORT=3000

# --- MongoDB ---
# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/gamic
# MongoDB Atlas (replace user, password and cluster host; keep /gamic as the database name):
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/gamic?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d
